# Copy to .env and fill in. NEVER commit the real .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string. Leave EMPTY to save enquiries in backend/data/enquiries.json
# (fine on your computer; use MongoDB Atlas when you deploy).
MONGODB_URI=

# Origin(s) of the public website allowed to send the contact form (comma-separated).
CORS_ORIGINS=http://localhost:5173

# ---- Email notifications (Brevo) ----------------------------------------------
# Every enquiry is emailed to NOTIFY_EMAILS. Leave BREVO_API_KEY empty to disable.
# BREVO_API_KEY: Brevo dashboard → SMTP & API → API keys → Generate a new API key (starts with xkeysib-)
# MAIL_FROM_EMAIL: must be a VERIFIED sender in Brevo (Senders, domains & dedicated IPs → Senders)
BREVO_API_KEY=
MAIL_FROM_NAME=IK Studio
MAIL_FROM_EMAIL=imirinnnb@gmail.com
NOTIFY_EMAILS=imirinnnb@gmail.com,kaviyashree2408@gmail.com

# Optional: forward each enquiry to the private CRM as a new lead.
# CRM_INTAKE_URL = the CRM backend's address, e.g. https://crm-api.onrender.com
# CRM_INTAKE_KEY = must equal INTAKE_KEY in the CRM backend's .env
# Leave both empty to only store enquiries here.
CRM_INTAKE_URL=
CRM_INTAKE_KEY=
