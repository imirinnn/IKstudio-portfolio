# Base URL of the API in ../backend (this project) (no trailing slash), e.g. https://your-api.onrender.com
VITE_API_URL=

# Optional: public studio website, shown as "Back to the website" on the sign-in page.
VITE_SITE_URL=

# Never set these in production. They exist only for sandboxed preview builds.
# VITE_CRM_DEMO=true         -> CRM runs on invented sample data in the browser
# VITE_ROUTER_MODE=memory    -> in-memory routing for iframes without real URLs
