# Copy to .env and fill in. NEVER commit the real .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas account owned by you).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Long random secret used to sign admin sessions (at least 32 characters).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long an admin stays signed in.
JWT_EXPIRES_IN=8h

# Origin(s) of the CRM frontend allowed to call this API.
CORS_ORIGINS=http://localhost:5174

# Shared secret that lets the studio website's backend send contact-form enquiries
# here as new leads (POST /api/intake/enquiries). Use the SAME value as CRM_INTAKE_KEY
# in the website backend. Leave empty to disable. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTAKE_KEY=

# The ONLY email address(es) allowed to sign in to the CRM (comma-separated).
# Any other account is refused, even with a correct password.
ADMIN_EMAILS=imirinnnb@gmail.com

# Used ONLY by `npm run create-admin` to create or reset an admin account.
# Remove these values from .env after running the script.
ADMIN_NAME=Irin
ADMIN_EMAIL=imirinnnb@gmail.com
ADMIN_PASSWORD=
